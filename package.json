{
  "name": "nextcloud-collectives",
  "version": "0.3.4",
  "description": "Obsidian plugin that syncs Nextcloud Collectives bidirectionally with a vault.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Martin Schumacher",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "release:check": "node scripts/check-release.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:perf": "vitest run --config vitest.performance.config.ts",
    "nc:up": "sh scripts/dev-nextcloud/up.sh",
    "nc:down": "sh scripts/dev-nextcloud/down.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.6.0",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
